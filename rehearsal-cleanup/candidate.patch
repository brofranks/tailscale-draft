+// ipv4FailingListener binds udp6 normally and fails every udp4 bind.
+type ipv4FailingListener struct{}
+
+func (ipv4FailingListener) ListenPacket(ctx context.Context, network, address string) (net.PacketConn, error) {
+	if network == "udp4" {
+		return nil, errors.New("udp4 unavailable")
+	}
+	return nettype.Std{}.ListenPacket(ctx, network, address)
+}
+
+// TestNewConnBindFailureReleasesIPv6 verifies that a NewConn whose IPv4
+// bind fails releases the IPv6 socket it bound first.
+func TestNewConnBindFailureReleasesIPv6(t *testing.T) {
+	if !hasUDPTransport {
+		t.Skip("requires UDP peer transport")
+	}
+	probe, err := net.ListenUDP("udp6", nil)
+	if err != nil {
+		t.Skipf("no IPv6: %v", err)
+	}
+	port := probe.LocalAddr().(*net.UDPAddr).Port
+	probe.Close()
+
+	bus := eventbustest.NewBus(t)
+	netMon, err := netmon.New(bus, logger.WithPrefix(t.Logf, "... netmon: "))
+	if err != nil {
+		t.Fatalf("netmon.New: %v", err)
+	}
+	defer netMon.Close()
+
+	_, err = NewConn(Options{
+		NetMon:                 netMon,
+		EventBus:               bus,
+		HealthTracker:          health.NewTracker(bus),
+		Metrics:                new(usermetric.Registry),
+		DisablePortMapper:      true,
+		Logf:                   t.Logf,
+		Port:                   uint16(port),
+		TestOnlyPacketListener: ipv4FailingListener{},
+	})
+	if err == nil {
+		t.Fatal("NewConn succeeded without IPv4")
+	}
+	c, err := net.ListenUDP("udp6", &net.UDPAddr{Port: port})
+	if err != nil {
+		t.Fatalf("IPv6 port %d still bound: %v", port, err)
+	}
+	c.Close()
+}
