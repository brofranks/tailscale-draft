+// TestCloseUsesInstalledRuleFamilies changes tunnel IPv6 availability after
+// Up. A rule added by this router must be removed, and one which predates an
+// IPv4-only startup must survive.
+func TestCloseUsesInstalledRuleFamilies(t *testing.T) {
+	const v6Rule = "-6 pref 5270 table 52"
+	for _, tc := range []struct {
+		name              string
+		startV6, repairV6 bool
+	}{
+		{"lost", true, false},
+		{"gained", false, false},
+		{"repaired-then-lost", false, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			r, host := newTestLinuxRouterBeforeUp(t, logger.Discard)
+			v6 := tc.startV6
+			r.interfaceV6Usable = func() bool { return v6 }
+			foreign := !tc.startV6 && !tc.repairV6
+			if foreign {
+				host.rules = append(host.rules, v6Rule)
+			}
+			if err := r.Up(); err != nil {
+				t.Fatal(err)
+			}
+			if tc.repairV6 {
+				// The host removed the existing rules and enabled tunnel IPv6.
+				host.rules = nil
+				v6 = true
+				r.ruleRestorePending.Store(true)
+				r.restoreIPRules()
+			}
+			if !slices.Contains(host.rules, v6Rule) {
+				t.Fatalf("missing rule before shutdown: %v", host.rules)
+			}
+			v6 = foreign
+			if err := r.Close(); err != nil {
+				t.Fatal(err)
+			}
+			if got := slices.Contains(host.rules, v6Rule); got != foreign {
+				t.Errorf("IPv6 rule present after Close = %t, want %t", got, foreign)
+			}
+		})
+	}
+}
