diff --git a/net/netmon/interfaces_test.go b/net/netmon/interfaces_test.go
index 55728e706c300160c5974f38f34d24e83589f29f..9d06d0f5ed6b8ee20a7ad1c32729aff313363b64 100644
--- a/net/netmon/interfaces_test.go
+++ b/net/netmon/interfaces_test.go
@@ -127,6 +127,42 @@ func TestLikelyHomeRouterIP(t *testing.T) {
 	})
 }
 
+func TestLocalAddressesCGNAT(t *testing.T) {
+	oldName, oldIndex := tsIfProps.tsIfName(), tsIfProps.tsIfIndex()
+	t.Cleanup(func() { tsIfProps.set(oldName, oldIndex) })
+	iface := func(name, ip string) Interface {
+		host := netip.MustParseAddr(ip)
+		return Interface{Interface: &net.Interface{Name: name, Flags: net.FlagUp},
+			AltAddrs: []net.Addr{&net.IPNet{IP: host.AsSlice(), Mask: net.CIDRMask(host.BitLen(), host.BitLen())}}}
+	}
+	lan := iface("lan", "100.70.1.9")
+	tunnel := iface("wg0", "100.70.1.10")
+	otherVPN := iface("tailscale0", "100.82.2.3")
+	ula := iface("lan6", "fd7a:115c:a1e0:2::9")
+	ifs := []Interface{lan, tunnel, otherVPN, ula}
+	tstest.Replace(t, &altNetInterfaces, func() ([]Interface, error) { return ifs, nil })
+	for _, tc := range []struct {
+		name, registered string
+		exclude          bool
+		want             []netip.Addr
+	}{
+		{"unregistered", "", false, nil},
+		{"registered", "wg0", false, []netip.Addr{netip.MustParseAddr("100.70.1.9"), netip.MustParseAddr("100.82.2.3")}},
+		{"tailscale", "wg0", true, nil},
+	} {
+		tsIfProps.set(tc.registered, 0)
+		got, _, err := LocalAddresses(tc.exclude)
+		if err != nil || !slices.Equal(got, tc.want) {
+			t.Errorf("%s: %v, %v; want %v", tc.name, got, err, tc.want)
+		}
+	}
+	ifs = []Interface{ula}
+	got, _, err := LocalAddresses(false)
+	if err != nil || len(got) != 0 {
+		t.Errorf("ULA-only = %v, %v, want no candidates", got, err)
+	}
+}
+
 func TestLocalAddressesSkipsTailscaleInterface(t *testing.T) {
 	up := net.FlagUp | net.FlagBroadcast | net.FlagMulticast | net.FlagRunning
 	tstest.Replace(t, &altNetInterfaces, func() ([]Interface, error) {
@@ -145,7 +181,7 @@ func TestLocalAddressesSkipsTailscaleInterface(t *testing.T) {
 	SetTailscaleInterfaceProps("wg0", 2)
 	t.Cleanup(func() { tsIfProps.set("", 0) })
 
-	regular, _, err := LocalAddresses()
+	regular, _, err := LocalAddresses(false)
 	if err != nil {
 		t.Fatal(err)
 	}
diff --git a/net/netmon/state.go b/net/netmon/state.go
index 6463f41d89328aa4c8fd98ec99eee290688391dd..faff62b0eee8d8ca8a880afd277f958c0fac5e41 100644
--- a/net/netmon/state.go
+++ b/net/netmon/state.go
@@ -56,7 +56,9 @@ func isProblematicInterface(nif *net.Interface) bool {
 // whether they're loopback addresses. If there are no regular addresses
 // it will return any IPv4 linklocal or IPv6 unique local addresses because we
 // know of environments where these are used with NAT to provide connectivity.
-func LocalAddresses() (regular, loopback []netip.Addr, err error) {
+// excludeCGNAT excludes IPv4 addresses in Tailscale's allocation range even
+// when the registered tunnel can be identified by name.
+func LocalAddresses(excludeCGNAT bool) (regular, loopback []netip.Addr, err error) {
 	// TODO(crawshaw): don't serve interface addresses that we are routing
 	ifaces, err := netInterfaces()
 	if err != nil {
@@ -89,12 +91,8 @@ func LocalAddresses() (regular, loopback []netip.Addr, err error) {
 					continue
 				}
 				ip = ip.Unmap()
-				// TODO(apenwarr): don't special case cgNAT.
-				// In the general wireguard case, it might
-				// very well be something we can route to
-				// directly, because both nodes are
-				// behind the same CGNAT router.
-				if tsaddr.IsTailscaleIP(ip) {
+				// With a known tunnel, another interface may be a reachable CGNAT LAN.
+				if tsaddr.IsTailscaleIP(ip) && (excludeCGNAT || tsIfName == "" || ip.Is6()) {
 					continue
 				}
 				if ip.IsLoopback() || ifcIsLoopback {
