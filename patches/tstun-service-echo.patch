From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brody Franks <brody@franks.id.au>
Date: Thu, 19 Nov 2026 10:23:15 -0800
Subject: [PATCH] net/tstun,tsd: answer echo only for configured service
 addresses

Let the daemon supply the destinations for local ICMP echo replies. An
embedding that owns no service address can route both former service IPs
to a WireGuard peer, including through a subnet or default route.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Brody Franks <brody@franks.id.au>
---
 net/tstun/wrap.go      | 36 +++++++++++++----------------
 net/tstun/wrap_test.go | 51 ++++++++++++++++++++++++++++++++++++++++++
 tsd/tsd.go             |  3 +++
 3 files changed, 70 insertions(+), 20 deletions(-)

diff --git a/net/tstun/wrap.go b/net/tstun/wrap.go
index a29b02c07140a9df5521a1eeda6fe36ea35ba0a0..c9f7e604b987b5f7fe2565bb8984be3a43a63f39 100644
--- a/net/tstun/wrap.go
+++ b/net/tstun/wrap.go
@@ -198,6 +198,10 @@ type Wrapper struct {
 	// PostFilterPacketOutboundToWireGuard is the outbound filter function that runs after the main filter.
 	PostFilterPacketOutboundToWireGuard FilterFunc
 
+	// ServiceEchoAddrs are the destinations for which the wrapper answers
+	// local ICMP echo requests. Set before Start.
+	ServiceEchoAddrs []netip.Addr
+
 	// OnTSMPPongReceived, if non-nil, is called whenever a TSMP pong arrives.
 	OnTSMPPongReceived func(packet.TSMPPongReply)
 
@@ -744,28 +748,20 @@ func (t *Wrapper) SetPeerRoutes(native4, native6 netip.Addr, routes *bart.Table[
 	}
 }
 
-var (
-	magicDNSIPPort   = netip.AddrPortFrom(tsaddr.TailscaleServiceIP(), 0) // 100.100.100.100:0
-	magicDNSIPPortv6 = netip.AddrPortFrom(tsaddr.TailscaleServiceIPv6(), 0)
-)
-
 func (t *Wrapper) filterPacketOutboundToWireGuard(p *packet.Parsed, pc *peerConfigTable, gro *gro.GRO) (filter.Response, *gro.GRO) {
-	// Fake ICMP echo responses to MagicDNS (100.100.100.100).
-	if p.IsEchoRequest() {
-		switch p.Dst {
-		case magicDNSIPPort:
-			header := p.ICMP4Header()
-			header.ToResponse()
-			outp := packet.Generate(&header, p.Payload())
-			t.InjectInboundCopy(outp)
-			return filter.DropSilently, gro // don't pass on to OS; already handled
-		case magicDNSIPPortv6:
-			header := p.ICMP6Header()
-			header.ToResponse()
-			outp := packet.Generate(&header, p.Payload())
-			t.InjectInboundCopy(outp)
-			return filter.DropSilently, gro // don't pass on to OS; already handled
+	if p.IsEchoRequest() && slices.Contains(t.ServiceEchoAddrs, p.Dst.Addr()) {
+		var response packet.Header
+		if p.IPVersion == 4 {
+			h := p.ICMP4Header()
+			h.ToResponse()
+			response = &h
+		} else {
+			h := p.ICMP6Header()
+			h.ToResponse()
+			response = &h
 		}
+		t.InjectInboundCopy(packet.Generate(response, p.Payload()))
+		return filter.DropSilently, gro
 	}
 
 	// TSMP traffic should only originate from tailscaled, not from the host
diff --git a/net/tstun/wrap_test.go b/net/tstun/wrap_test.go
