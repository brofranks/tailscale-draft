@@ -1375,3 +1377,52 @@ func TestStackGSOToTunGSO(t *testing.T) {
 		})
 	}
 }
+
+func TestServiceEchoAddrs(t *testing.T) {
+	echo := func(src, dst netip.Addr) *packet.Parsed {
+		var h packet.Header = &packet.ICMP4Header{
+			IP4Header: packet.IP4Header{IPProto: ipproto.ICMPv4, Src: src, Dst: dst},
+			Type:      packet.ICMP4EchoRequest,
+		}
+		if dst.Is6() {
+			h = &packet.ICMP6Header{
+				IP6Header: packet.IP6Header{IPProto: ipproto.ICMPv6, Src: src, Dst: dst},
+				Type:      packet.ICMP6EchoRequest,
+			}
+		}
+		p := new(packet.Parsed)
+		p.Decode(packet.Generate(h, make([]byte, 4))) // identifier and sequence
+		if !p.IsEchoRequest() {
+			t.Fatalf("not an echo request: %v", p)
+		}
+		return p
+	}
+
+	v4 := netip.MustParseAddr("10.42.0.53")
+	v6 := netip.MustParseAddr("fd42::53")
+	legacy := []netip.Addr{tsaddr.TailscaleServiceIP(), tsaddr.TailscaleServiceIPv6()}
+	for _, tc := range []struct {
+		name  string
+		addrs []netip.Addr
+	}{{"none", nil}, {"custom", []netip.Addr{v4, v6}}, {"tailscale", legacy}} {
+		t.Run(tc.name, func(t *testing.T) {
+			_, tun := newFakeTUN(t.Logf, eventbustest.NewBus(t), false)
+			defer tun.Close()
+			tun.ServiceEchoAddrs = tc.addrs
+			tun.SetFilter(filter.NewAllowAllForTest(t.Logf))
+			for _, dst := range []netip.Addr{v4, v6, legacy[0], legacy[1]} {
+				src := netip.MustParseAddr("10.42.0.1")
+				if dst.Is6() {
+					src = netip.MustParseAddr("fd42::1")
+				}
+				want := filter.Accept
+				if slices.Contains(tc.addrs, dst) {
+					want = filter.DropSilently
+				}
+				if got, _ := tun.filterPacketOutboundToWireGuard(echo(src, dst), nil, nil); got != want {
+					t.Errorf("%v: filter response = %v, want %v", dst, got, want)
+				}
+			}
+		})
+	}
+}
