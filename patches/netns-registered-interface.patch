From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brody Franks <brody@franks.id.au>
Date: Thu, 19 Nov 2026 12:45:41 -0800
Subject: [PATCH] net/netns: resolve the registered Darwin tunnel by name

Resolve the live tunnel before comparing route indices. An index from
an earlier registration may belong to a different device. Reject a
confirmed tunnel default in both monitored and unmonitored sockets.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Brody Franks <brody@franks.id.au>
---
 net/netns/netns_darwin.go      | 36 ++++++++++++++++-------
 net/netns/netns_darwin_test.go | 54 ++++++++++++++++++++++++++++++++++
 2 files changed, 79 insertions(+), 11 deletions(-)

diff --git a/net/netns/netns_darwin.go b/net/netns/netns_darwin.go
index 844128ddaca7d3bd8aafd77783de761d6d59c0eb..590a0d5a022478ee916bf9273dcff952d7562d1e 100644
--- a/net/netns/netns_darwin.go
+++ b/net/netns/netns_darwin.go
@@ -33,6 +33,7 @@ func control(logf logger.Logf, netMon *netmon.Monitor) func(network, address str
 var bindToInterfaceByRouteEnv = envknob.RegisterBool("TS_BIND_TO_INTERFACE_BY_ROUTE")
 
 var errInterfaceStateInvalid = errors.New("interface state invalid")
+var errTunnelUnderlay = errors.New("default route selects the tunnel interface")
 
 // controlLogf binds c to a particular interface as necessary to dial the
 // provided (network, address).
@@ -47,6 +48,9 @@ func controlLogf(logf logger.Logf, netMon *netmon.Monitor, network, address stri
 
 	idx, err := getInterfaceIndex(logf, netMon, address)
 	if err != nil {
+		if errors.Is(err, errTunnelUnderlay) {
+			return err
+		}
 		// callee logged
 		return nil
 	}
@@ -68,7 +72,7 @@ func getInterfaceIndex(logf logger.Logf, netMon *netmon.Monitor, address string)
 				}
 				return -1, err
 			}
-			return idx, nil
+			return checkDefaultInterface(idx, nil)
 		}
 		state := netMon.InterfaceState()
 		if state == nil {
@@ -98,15 +102,7 @@ func getInterfaceIndex(logf logger.Logf, netMon *netmon.Monitor, address string)
 			logf("netns: [unexpected] os default if %q (%d) != netmon cached if %q (%d)", osIf.InterfaceName, osIf.InterfaceIndex, cachedIdx.Name, cachedIdx.Index)
 		}
 
-		// Sanity check to make sure we didn't pick the tailscale interface
-		if tsif, err2 := tailscaleInterface(); tsif != nil && err2 == nil && errOut == nil {
-			if tsif.Index == idx {
-				idx = -1
-				errOut = errInterfaceStateInvalid
-			}
-		}
-
-		return idx, errOut
+		return checkDefaultInterface(idx, errOut)
 	}
 
 	useRoute := bindToInterfaceByRoute.Load() || bindToInterfaceByRouteEnv()
@@ -143,10 +139,28 @@ func getInterfaceIndex(logf logger.Logf, netMon *netmon.Monitor, address string)
 	return idx, err
 }
 
+// checkDefaultInterface prevents a confirmed tunnel route from being used
+// as the underlay, including when no monitor was provided.
+func checkDefaultInterface(idx int, err error) (int, error) {
+	if err == nil {
+		name, _ := netmon.TailscaleInterfaceName()
+		if name == "" {
+			return idx, nil
+		}
+		if iface, lookupErr := net.InterfaceByIndex(idx); lookupErr == nil && iface.Name == name {
+			return -1, errTunnelUnderlay
+		}
+	}
+	return idx, err
+}
+
 // tailscaleInterface returns the current machine's Tailscale interface, if any.
 // If none is found, (nil, nil) is returned.
-// A non-nil error is only returned on a problem listing the system interfaces.
+// A registered name is authoritative, even if that device no longer exists.
 func tailscaleInterface() (*net.Interface, error) {
+	if name, err := netmon.TailscaleInterfaceName(); err == nil {
+		return net.InterfaceByName(name)
+	}
 	ifs, err := net.Interfaces()
 	if err != nil {
 		return nil, err
diff --git a/net/netns/netns_darwin_test.go b/net/netns/netns_darwin_test.go
index 768b095b8273985837747f4db266f3e71a41cf35..905965324e0f5a069d5263a663b5628108f168d7 100644
--- a/net/netns/netns_darwin_test.go
+++ b/net/netns/netns_darwin_test.go
@@ -4,6 +4,9 @@
 package netns
 
 import (
+	"errors"
+	"net"
+	"syscall"
 	"testing"
 
 	"tailscale.com/net/netmon"
@@ -82,3 +85,54 @@ func TestGetInterfaceIndex(t *testing.T) {
 		}
 	})
 }
+
+func TestRegisteredTunnelBinding(t *testing.T) {
+	name, _ := netmon.TailscaleInterfaceName()
+	index, _ := netmon.TailscaleInterfaceIndex()
+	t.Cleanup(func() { netmon.SetTailscaleInterfaceProps(name, index) })
+	lo, err := net.InterfaceByName("lo0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The registered index may now belong to another device.
+	netmon.SetTailscaleInterfaceProps(lo.Name, lo.Index+1)
+	if got, err := tailscaleInterface(); err != nil || got.Index != lo.Index {
+		t.Fatalf("registered tunnel = %v, %v, want %v", got, err, lo)
+	}
+	if _, err := checkDefaultInterface(lo.Index, nil); !errors.Is(err, errTunnelUnderlay) {
+		t.Fatalf("tunnel as default: %v", err)
+	}
+	if got, err := checkDefaultInterface(lo.Index+1, nil); err != nil || got != lo.Index+1 {
+		t.Fatalf("reused index = %v, %v", got, err)
+	}
+	t.Run("self-default-socket", func(t *testing.T) {
+		idx, err := netmon.DefaultRouteInterfaceIndex()
+		if errors.Is(err, netmon.ErrNoGatewayIndexFound) {
+			t.Skip("requires a default route")
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		iface, err := net.InterfaceByIndex(idx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		netmon.SetTailscaleInterfaceProps(iface.Name, lo.Index)
+		oldRoute := bindToInterfaceByRoute.Swap(false)
+		t.Cleanup(func() { bindToInterfaceByRoute.Store(oldRoute) })
+		lc := net.ListenConfig{Control: func(network, _ string, c syscall.RawConn) error {
+			return controlLogf(t.Logf, nil, network, "192.0.2.1:9", c)
+		}}
+		conn, err := lc.ListenPacket(t.Context(), "udp4", "0.0.0.0:0")
+		if err == nil {
+			conn.Close()
+		}
+		if !errors.Is(err, errTunnelUnderlay) {
+			t.Fatalf("socket with tunnel as default: %v", err)
+		}
+	})
+	netmon.SetTailscaleInterfaceProps("missing-registered-utun", lo.Index)
+	if got, err := tailscaleInterface(); err == nil || got != nil {
+		t.Fatalf("removed tunnel = %v, %v", got, err)
+	}
+}
